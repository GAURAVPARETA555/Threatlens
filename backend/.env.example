# ==============================================================================
# Cyber-Project Backend Environment Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory: cp .env.example .env
# 2. Fill in your actual secrets and configuration in .env
# 3. NEVER commit your real .env file or credentials to Git/GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# In production, generate a secure random key:
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace_with_a_secure_random_django_secret_key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to connect to this Django instance
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Groq AI Integration
# ------------------------------------------------------------------------------
# Your Groq Cloud API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Chat Completion Model (default: openai/gpt-oss-120b)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Groq API endpoint
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# ------------------------------------------------------------------------------
# Machine Learning Microservice
# ------------------------------------------------------------------------------
# URL for attack classification service (e.g. mock_ml.py or external ML API)
ML_SERVICE_URL=http://127.0.0.1:8001/predict/

# ------------------------------------------------------------------------------
# Database Settings (Optional)
# ------------------------------------------------------------------------------
# If DATABASE_ENGINE is left blank or unset, Django defaults to local db.sqlite3.
# For production PostgreSQL:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=cybersecurity_db
# DATABASE_USER=cyber_user
# DATABASE_PASSWORD=your_secure_db_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# Security & Origins (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted origins for CSRF and CORS (if applicable)
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
